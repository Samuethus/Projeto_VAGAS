# Copie este arquivo para .env e preencha com a configuração do app WEB do Firebase:
# Console do Firebase > Configurações do projeto (engrenagem) > Geral > Seus apps > app Web > SDK setup and configuration > Config.
# Depois rode:  powershell -ExecutionPolicy Bypass -File scripts\gerar_config.ps1
#
# Esses valores são públicos por natureza (vão para o navegador). Quem protege os dados são as regras em firestore.rules.
# NUNCA coloque aqui o JSON de conta de serviço (firebase-adminsdk / private_key).

FIREBASE_API_KEY=AIza...
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_APP_ID=1:000000000000:web:0000000000000000
