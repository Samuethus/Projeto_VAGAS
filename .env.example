# Copie este arquivo para .env e preencha com os dados do projeto no Supabase:
# Painel do Supabase > Project Settings > API Keys (chave publishable) e Data API (Project URL).
# Depois rode:  powershell -ExecutionPolicy Bypass -File scripts\gerar_config.ps1
#
# Esses valores são públicos por natureza (vão para o navegador). Quem protege os dados são as permissões em supabase/schema.sql.
# NUNCA coloque aqui a chave secret (sb_secret_...) nem a service_role.

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sb_publishable_...
