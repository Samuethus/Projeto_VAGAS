# --- Segredos e configuração local ---
links_power.txt
.json
*.json
.env
.env.local
.env.*.local
.env.*
!.env.example
# .mcp.json só tem o endereço do MCP do Survey Monkey (login por OAuth, sem token)
!.mcp.json
# firebase.json só aponta para o arquivo de regras (sem chaves).
!firebase.json
# Credenciais de conta de serviço do Firebase NUNCA vão para o Git.
*serviceAccount*
*firebase-adminsdk*
# config.js (gerado do .env) VAI para o Git de propósito: o site no GitHub Pages precisa dele.
# Só pode conter a configuração WEB do Firebase (apiKey, projectId, appId...). NUNCA uma conta de serviço.
.firebase/
firebase-debug.log
*.pem
*.key

# --- Ferramentas locais (a permissão salva pode conter chaves coladas) ---
.claude/

